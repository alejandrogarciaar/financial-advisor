FMP_API_KEY=your_financial_modeling_prep_api_key_here
# Solo hace falta si se usa src/data/sosovalue_client.py (ETFs spot cripto: BTC/ETH/SOL) — key
# gratuita en sosovalue.com/developer (free tier: 20 req/min, 100.000 req/mes).
SOSOVALUE_API_KEY=your_sosovalue_api_key_here
# Solo hace falta para scripts/telegram_portfolio_bot.py (registrar compras/ventas de Portafolio
# por Telegram). TELEGRAM_TOKEN se puede copiar del .env de market-signals-telegram (ese bot solo
# envía alertas, nunca escucha comandos, no hay conflicto). TELEGRAM_CHAT_ID en cambio TIENE que
# ser el chat PRIVADO (1 a 1) con el bot, nunca un grupo — ver README.md, sección "Actualizar el
# portafolio desde Telegram", para el motivo y cómo conseguirlo.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
