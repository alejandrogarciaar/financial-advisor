FMP_API_KEY=your_financial_modeling_prep_api_key_here

# Para scripts/telegram_alerts.py (manual) y scripts/telegram_tactical_signals.py (programado
# via GitHub Actions) — gratis, se crean hablándole a @BotFather en Telegram. Sin esto ninguno de
# los dos scripts falla, solo no mandan nada. Para el workflow programado, agregar estas mismas
# 2 claves como Secrets del repo (Settings -> Secrets and variables -> Actions) — el .env local
# no existe en el runner de GitHub Actions.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
